# Environment Configuration Example for DECEIT

# Server Ports
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:deceit_secure_password@localhost:5432/deceit_db?schema=public"

# Cache & Real-Time Sync (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Sessions
JWT_SECRET="super-secret-jwt-key-change-in-production"
SESSION_SECRET="super-secret-session-key-change-in-production"

# OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Client Public URLs
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
